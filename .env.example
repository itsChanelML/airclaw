# AirClaw — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then either export manually:
#   export NIM_API_KEY=your_key_here
#
# Or let python-dotenv load it automatically —
# both run_demo.py and run_model_eval.py load .env on startup.
# ─────────────────────────────────────────────────────────────


# ── REQUIRED ──────────────────────────────────────────────────

# Your NVIDIA NIM API key
# Get it free at: https://build.nvidia.com
# Search: llama-3.3-nemotron-super-49b-v1 → Get API Key
# Your key will start with: nvapi-
NIM_API_KEY=your_nim_api_key_here


# ── OPTIONAL — override defaults ──────────────────────────────

# NIM endpoint (default: NVIDIA hosted — no change needed unless self-hosting)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# NIM model id. Default: nvidia/nemotron-3-super-120b-a12b
# NVIDIA retires hosted models on published EOL dates — a retired model returns
# HTTP 410 Gone on every call. If that happens, list what is currently served:
#   curl -s https://integrate.api.nvidia.com/v1/models \
#     -H "Authorization: Bearer $NIM_API_KEY" | grep -o '"id":"[^"]*"'
# NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Airflow home directory (default: ./airflow_home, created by run_airflow.sh)
# AIRFLOW_HOME=/path/to/your/airflow_home

# Repo root override. Only needed if you run the DAGs from a copy outside
# this repo — the DAGs and operator use it to find data/ and tools/.
# AIRCLAW_HOME=/path/to/airclaw
