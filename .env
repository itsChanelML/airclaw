# AirClaw — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then either export manually:
#   export NIM_API_KEY=your_key_here
#
# Or let python-dotenv load it automatically —
# both run_demo.py and run_model_eval.py load .env on startup.
# ─────────────────────────────────────────────────────────────


# ── REQUIRED ──────────────────────────────────────────────────

# Your NVIDIA NIM API key
# Get it free at: https://build.nvidia.com
# Search: llama-3.3-nemotron-super-49b-v1 → Get API Key
# Your key will start with: nvapi-
NIM_API_KEY=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


# ── OPTIONAL — override defaults ──────────────────────────────

# NIM endpoint (default: NVIDIA hosted — no change needed unless self-hosting)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Airflow home directory (default: ./airflow_home)
# AIRFLOW_HOME=/path/to/your/airflow_home

# Active data files — swapped automatically by the demo runners.
# Only set these if you want to point at your own data.
# AIRCLAW_311_FILE=/absolute/path/to/nyc_311_upstream.csv
# AIRCLAW_EVAL_FILE=/absolute/path/to/model_eval_upstream.csv
